{
  "name": "modular-js-project-yarn.js",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "clean": "rmdir /s /q node_modules && del yarn.lock",
    "reinstall": "yarn run clean && yarn install",
    "info": "node -e \"console.log('Node version:', process.version)\""
  },
  "dependencies": {
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "uuid": "^13.0.0"
  }
}